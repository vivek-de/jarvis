# ── JARVIS configuration (copy to .env; NEVER commit .env) ───────────────────
# Every value here has a safe default in backend/config.py. Uncomment to override.

# ── App ──────────────────────────────────────────────────────────────────────
JARVIS_APP_HOST=127.0.0.1
JARVIS_APP_PORT=8100
JARVIS_LOG_LEVEL=INFO
JARVIS_ENV=dev

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite holds conversation sessions (Phase 1+). Path relative to project root.
JARVIS_DB_PATH=data/jarvis.db

# ── Long-term memory (Postgres + pgvector, Phase 3) ───────────────────────────
# Leave DATABASE_URL blank to disable long-term memory (JARVIS still runs).
JARVIS_DATABASE_URL=postgresql://mahavir@localhost:5432/jarvis
JARVIS_EMBED_MODEL=nomic-embed-text
JARVIS_EMBED_DIM=768
JARVIS_MEMORY_DEDUPE_THRESHOLD=0.92
JARVIS_MEMORY_RETRIEVE_TOP_K=5

# ── Local model (Ollama) — the system runs fully on this alone ────────────────
JARVIS_OLLAMA_BASE_URL=http://localhost:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b

# ── Model router task slots.  Format: "provider:model"  ───────────────────────
# provider ∈ {ollama, anthropic, openai, gemini}.  Default: everything local.
JARVIS_MODEL_GENERAL=ollama:llama3.1:8b
JARVIS_MODEL_FAST=ollama:llama3.1:8b
JARVIS_MODEL_CODING=ollama:llama3.1:8b
JARVIS_MODEL_REASONING=ollama:llama3.1:8b
JARVIS_MODEL_LOCAL=ollama:llama3.1:8b
JARVIS_MODEL_TRADING=ollama:llama3.1:8b

# ── Cloud provider keys (OPTIONAL, key-gated).  Leave blank to stay 100% local ─
JARVIS_ANTHROPIC_API_KEY=
JARVIS_OPENAI_API_KEY=
JARVIS_GEMINI_API_KEY=

# ── Spend cap — refuse cloud calls past this many ₹/day, fall back to LOCAL ────
JARVIS_DAILY_SPEND_CAP_INR=200
JARVIS_USD_INR_RATE=88.0

# ── Security ──────────────────────────────────────────────────────────────────
JARVIS_RATE_LIMIT_PER_MIN=60
# SSRF allowlist: hosts the browser/fetch layer (Phase 7) may reach besides
# public web. Comma-separated host:port. OptionIQ + Ollama are pre-allowed.
JARVIS_SSRF_ALLOWLIST=127.0.0.1:3001,localhost:3001,127.0.0.1:11434,localhost:11434

# ── OptionIQ integration (READ-ONLY; wired in Phase 13) ───────────────────────
JARVIS_OPTIONIQ_BASE_URL=http://localhost:3001

# ── Use-case toggles (all OFF in Phase 1; enabled in their phases) ────────────
JARVIS_UC1_MORNING_BRIEF=false
JARVIS_UC2_KITE_TOKEN_GUARD=false
JARVIS_UC3_TRADE_JOURNAL_COACH=false
JARVIS_UC4_PLACEMENT_PREP=false
JARVIS_UC5_PROJECT_MEMORY=false
JARVIS_UC6_CODEBASE_QA=false
JARVIS_UC7_MARKET_ALERTS=false
JARVIS_UC8_WEEKLY_REVIEW=false

# ── Telegram (Phase 10) — optional; both blank = Telegram disabled ───────────
# TELEGRAM_TOKEN: the bot token from @BotFather (see docs/TELEGRAM_SETUP.md)
# TELEGRAM_CHAT_ID: the ONLY chat the bot will talk to; all others are ignored
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
